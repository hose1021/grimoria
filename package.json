{
  "name": "grimoria",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.app.json && tsc -p tsconfig.core.json && tsc -p tsconfig.test.json",
    "test": "node --test \"js/**/*.test.mjs\" \"src/**/*.test.ts\"",
    "fallback": "node scripts/build-fallback.mjs --root dist",
    "offline": "node scripts/build-offline.mjs --root dist --out dist/sw.js",
    "verify": "npm run typecheck && npm test && npm run build && npm run fallback && npm run offline && node scripts/check-types-policy.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.7"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
