{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grimoria:rule-registry:v1",
  "title": "Grimoria rule registry",
  "type": "object",
  "required": ["schemaVersion", "rules"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "edition", "level", "revision", "requirement", "assertingTests"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^(TB|BMR|SNV|SYS)-[A-Z0-9]+-[0-9]{2}$" },
        "roleId": { "type": "string", "minLength": 1 },
        "edition": { "enum": ["tb", "bmr", "snv", "shared"] },
        "level": {
          "enum": ["verified", "implemented-unverified", "host-choice", "unsupported"]
        },
        "revision": { "type": "string", "minLength": 2, "pattern": "^\\S(?:.*\\S)?$" },
        "requirement": { "type": "string", "minLength": 1 },
        "assertingTests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/test" }
        }
      }
    },
    "test": {
      "type": "object",
      "required": ["file", "name"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    }
  }
}
