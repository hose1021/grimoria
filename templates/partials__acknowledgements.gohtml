{{define "partials/acknowledgements"}}<details class="details" id="acknowledgements">
    <summary class="details__summary">
        <h2 class="details__heading">{{T "acknowledgements.title"}}</h2>
    </summary>
    <div class="details__body">
    <p>{{TH "acknowledgements.acknowledgements.0"}}</p>
    <p>{{TH "acknowledgements.acknowledgements.1"}}</p>
    <p>{{TH "acknowledgements.acknowledgements.2"}}</p>
    <p>{{TH "acknowledgements.acknowledgements.3"}}</p>
    <p>{{TH "acknowledgements.acknowledgements.4"}}</p>
    <p>{{TH "acknowledgements.acknowledgements.5"}}</p>
    <p>{{TH "acknowledgements.acknowledgements.6"}}</p>
    
    </div>
</details>
{{end}}
