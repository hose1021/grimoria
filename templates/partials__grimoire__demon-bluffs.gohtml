{{define "partials/grimoire/demon-bluffs"}}<div class="pad pad--bluffs bluffs">
    <div class="carousel" id="demon-bluffs-group"></div>
    <ul class="button-list mt-4">
        <li><button type="button" class="button button--full-height" id="show-all-bluffs" data-title="{{T "grimoire.grimoire.bluffs"}}">{{T "grimoire.grimoire.show_bluffs"}}</button></li>
        <li><button type="button" class="button button--full-height" id="add-bluffs">{{T "grimoire.grimoire.add_bluffs"}}</button></li>
    </ul>
</div>

<template id="demon-bluffs-template">
    <div class="carousel__item js--demon-bluffs--group">
        <form class="settable-title bluffs__heading pad__title">
            <h3 class="settable-title__title bluffs__title js--settable-title--title">{{T "grimoire.grimoire.bluffs"}}</h3>
            <input type="text" class="settable-title__input bluffs__input js--settable-title--input" list="bluffs-title-list" hidden>
            <datalist id="bluffs-title-list">
                <option value="{{T "grimoire.grimoire.bluffs"}}" class="js--settable-title--start">
                <option value="{{T "grimoire.grimoire.bluffs"}}" class="js--settable-title--previous">
            </datalist>

            <button type="button" class="bluffs__remove no-btn js--demon-bluffs--remove" aria-label="{{T "grimoire.reminder_show.remove"}}">
                <svg xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 448 512" aria-hidden="true"><!--! Font Awesome Free 6.4.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2023 Fonticons, Inc. --><path style="fill: currentColor;" d="M135.2 17.7C140.6 6.8 151.7 0 163.8 0H284.2c12.1 0 23.2 6.8 28.6 17.7L320 32h96c17.7 0 32 14.3 32 32s-14.3 32-32 32H32C14.3 96 0 81.7 0 64S14.3 32 32 32h96l7.2-14.3zM32 128H416V448c0 35.3-28.7 64-64 64H96c-35.3 0-64-28.7-64-64V128zm96 64c-8.8 0-16 7.2-16 16V432c0 8.8 7.2 16 16 16s16-7.2 16-16V208c0-8.8-7.2-16-16-16zm96 0c-8.8 0-16 7.2-16 16V432c0 8.8 7.2 16 16 16s16-7.2 16-16V208c0-8.8-7.2-16-16-16zm96 0c-8.8 0-16 7.2-16 16V432c0 8.8 7.2 16 16 16s16-7.2 16-16V208c0-8.8-7.2-16-16-16z"/></svg>
            </button>
        </form>
        <div class="bluffs__list">
            <button type="button" data-index="0" class="token token--bluff js--demon-bluffs--bluff" data-token="character" data-bluff-dialog="#bluff-show"></button>
                <button type="button" data-index="1" class="token token--bluff js--demon-bluffs--bluff" data-token="character" data-bluff-dialog="#bluff-show"></button>
                <button type="button" data-index="2" class="token token--bluff js--demon-bluffs--bluff" data-token="character" data-bluff-dialog="#bluff-show"></button>
        </div>
    </div>
</template>

<dialog class="dialog dialog--blur-background" id="bluff-show" data-dialog-hide-on="backdrop" aria-described-by="header-bluff-show" tabindex="-1">
    <div class="dialog__content">
        <div class="dialog__header">
            <h2 id="header-bluff-show" class="dialog__title"><span id="bluff-show-name" data-no-character="{{T "grimoire.bluff_show.empty"}}">{{T "grimoire.bluff_show.title"}}</span></h2>
            <div class="dialog__hide-wrapper">
                <button class="dialog__hide" type="button" aria-label="{{T "dialog.close"}}" data-dialog-hide>&times;</button>
            </div>
        </div>
        <div class="dialog__body">
    <p id="bluff-show-ability" class="character-show__ability"></p>
    <p id="bluff-show-orphan"><strong class="character-show__orphan">{{T "grimoire.character_show.orphan"}}</strong></p>
    <ul class="button-list">
        <li><button type="button" class="button" id="bluff-show-token">{{T "grimoire.bluff_show.show"}}</button></li>
        <li><button type="button" class="button" data-dialog="#bluff-list">{{T "grimoire.bluff_show.change"}}</button></li>
    </ul>
    
        </div>
    </div>
</dialog>

<dialog class="dialog dialog--blur-background" id="bluff-list" data-dialog-hide-on="backdrop" aria-described-by="header-bluff-list" tabindex="-1">
    <div class="dialog__content">
        <div class="dialog__header">
            <h2 id="header-bluff-list" class="dialog__title">{{T "grimoire.bluff_list.title"}}</h2>
            <div class="dialog__hide-wrapper">
                <button class="dialog__hide" type="button" aria-label="{{T "dialog.close"}}" data-dialog-hide>&times;</button>
            </div>
        </div>
        <div class="dialog__body">
    <ul id="character-list__bluffs" class="button-list button-list--reminder character-list mb-4"></ul>

    <ul class="no-list">
        {{switch (dict "node" "li" "label" (T "grimoire.bluff_list.show_existing") "name" "show" "id" "show-existing" "value" "existing")}}
        {{switch (dict "node" "li" "label" (T "grimoire.bluff_list.show_travellers") "name" "show" "id" "show-travellers" "value" "traveller")}}
        {{switch (dict "node" "li" "label" (T "grimoire.bluff_list.show_evil") "name" "show" "id" "show-evil" "value" "evil")}}
    </ul>

    
        </div>
    </div>
</dialog>
{{end}}
