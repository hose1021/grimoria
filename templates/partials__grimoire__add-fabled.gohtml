{{define "partials/grimoire/add-fabled"}}<button type="button" class="button button--full-height" id="add-fabled" data-dialog="#fabled-list" disabled>{{T "grimoire.grimoire.add_fabled"}}</button>

<dialog class="dialog dialog--blur-background" id="fabled-list" data-dialog-hide-on="backdrop" aria-described-by="header-fabled-list" tabindex="-1">
    <div class="dialog__content">
        <div class="dialog__header">
            <h2 id="header-fabled-list" class="dialog__title">{{T "grimoire.fabled_list.title"}}</h2>
            <div class="dialog__hide-wrapper">
                <button class="dialog__hide" type="button" aria-label="{{T "dialog.close"}}" data-dialog-hide>&times;</button>
            </div>
        </div>
        <div class="dialog__body">
        <ul id="fabled-list__list" class="button-list button-list--reminder"></ul>
    
        </div>
    </div>
</dialog>
{{end}}
