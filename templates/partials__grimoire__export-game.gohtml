{{define "partials/grimoire/export-game"}}<button type="button" class="button button--full-height" id="export-game" data-dialog="#game-export">{{T "grimoire.export.title"}}</button>

<dialog class="dialog dialog--hide-background" id="game-export" data-dialog-hide-on="" aria-described-by="header-game-export" tabindex="-1">
    <div class="dialog__content">
        <div class="dialog__header">
            <h2 id="header-game-export" class="dialog__title">{{T "grimoire.export.title"}}</h2>
            <div class="dialog__hide-wrapper">
                <button class="dialog__hide" type="button" aria-label="{{T "dialog.close"}}" data-dialog-hide>&times;</button>
            </div>
        </div>
        <div class="dialog__body">
        <p>{{TH "grimoire.export.markup"}}</p>
        <p>
            <button type="button" class="button" id="export-trigger">
                <span class="button__text">{{T "grimoire.export.button"}}</span>
                <span class="button__loader" role="progressbar" aria-valuetext="Loading" aria-busy="false" aria-live="assertive" aria-valuemin="0" aria-valuemax="1">
                    <span class="loader" aria-hidden="true"></span>
                </span>
            </button>
        </p>
        <div id="export-holder" hidden>
            <img src="" alt="" id="export-image" width="148" height="148" class="mx-auto">
        </div>
    
        </div>
    </div>
</dialog>
{{end}}
