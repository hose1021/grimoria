{{define "partials/setup/select-edition"}}<button type="button" class="button button--full-height" id="select-edition" data-dialog="#edition-list">{{T "setup.buttons.select_edition"}}</button>

<dialog class="dialog dialog--blur-background" id="edition-list" data-dialog-hide-on="backdrop" aria-described-by="header-edition-list" tabindex="-1">
    <div class="dialog__content">
        <div class="dialog__header">
            <h2 id="header-edition-list" class="dialog__title">{{T "setup.editions.title"}}</h2>
            <div class="dialog__hide-wrapper">
                <button class="dialog__hide" type="button" aria-label="{{T "dialog.close"}}" data-dialog-hide>&times;</button>
            </div>
        </div>
        <div class="dialog__body">
    <form id="select-edition-form" enctype="multipart/form-data">

        <details name="select-edition" class="edition-details" data-id="official" open>
            <summary class="edition-details__summary">{{T "setup.editions.official"}}</summary>
            <div class="edition-details__body">
                <ul class="no-list">
                    <li>
                        {{radio (dict "name" "edition" "value" "tb" "label" (T "setup.editions.trouble_brewing") "required" true)}}
                    </li>
                    <li>
                        {{radio (dict "name" "edition" "value" "bmr" "label" (T "setup.editions.bad_moon_rising"))}}
                    </li>
                    <li>
                        {{radio (dict "name" "edition" "value" "snv" "label" (T "setup.editions.sects_and_violets"))}}
                    </li>
                </ul>
            </div>
        </details>
        <details name="select-edition" class="edition-details" data-id="upload">
            <summary class="edition-details__summary">{{T "setup.editions.upload"}}</summary>
            <div class="edition-details__body">
                <label for="custom-script-upload" class="sr-only">{{T "setup.editions.upload"}}</label>
                {{file (dict "name" "custom-script-upload" "id" "custom-script-upload" "accept" "application/json" "required" true)}}
            </div>
        </details>
        <details name="select-edition" class="edition-details" data-id="url">
            <summary class="edition-details__summary">{{T "setup.editions.url"}}</summary>
            <div class="edition-details__body">
                <label for="custom-script-url" class="sr-only">{{T "setup.editions.url"}}</label>
                <input type="url" name="custom-script-url" id="custom-script-url" class="input" placeholder="https://www.example.com/script.json" required data-no-store>
            </div>
        </details>
        <details name="select-edition" class="edition-details" data-id="paste">
            <summary class="edition-details__summary">{{T "setup.editions.paste"}}</summary>
            <div class="edition-details__body">
                <label for="custom-script-paste" class="sr-only">{{T "setup.editions.paste"}}</label>
                <textarea name="custom-script-paste" id="custom-script-paste" class="input" placeholder='["washerwoman","investigator","librarian","chef"]' required></textarea>
            </div>
        </details>
        <details name="select-edition" class="edition-details" data-id="botc">
            <summary class="edition-details__summary">{{T "setup.editions.botc"}}</summary>
            <div class="edition-details__body">
                <label for="botc-scripts">{{T "setup.editions.lookup"}}</label>
                <div class="media mb-4">
                    <input type="text" name="botc-scripts" id="botc-scripts" class="input media__body" required data-no-store>
                    <button type="button" class="button media__side" id="botc-scripts-lookup">
                        <span class="d-flex">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" aria-label="{{T "setup.editions.select"}}" class="locale-form__icon"><!--! Font Awesome Pro 6.1.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2022 Fonticons, Inc. --><title id="tick-icon">{{T "setup.editions.select"}}</title><path style="fill: currentColor;" d="M438.6 105.4C451.1 117.9 451.1 138.1 438.6 150.6L182.6 406.6C170.1 419.1 149.9 419.1 137.4 406.6L9.372 278.6C-3.124 266.1-3.124 245.9 9.372 233.4C21.87 220.9 42.13 220.9 54.63 233.4L159.1 338.7L393.4 105.4C405.9 92.88 426.1 92.88 438.6 105.4H438.6z"/></svg>
                        </span>
                    </button>
                </div>
                <div id="botc-scripts">
                    <p class="align-centre" id="botc-scripts-loader" hidden>
                        <span class="loader" aria-hidden="true">
                            <span class="loader" aria-hidden="true"></span>
                        </span>
                    </p>
                    <p id="botc-scripts-empty" hidden>{{T "setup.editions.no_results"}}</p>
                    <ul id="botc-scripts-results" class="no-list edition-details__entries" hidden></ul>
                </div>
            </div>
        </details>

        <template id="botc-scripts-entry">
            <li>
                <label class="radio edition-details__radio js--botc-scripts--label">
                    <span class="radio__wrapper">
                        <input
                            type="radio"
                            name="botc-script"
                            class="radio__input js--botc-scripts--input"
                        >
                        <span class="radio__render"></span>
                    </span>
                    <span class="radio__label">
                        <strong class="edition-details__name js--botc-scripts--name"></strong>
                        <small class="edition-details__author js--botc-scripts--author"></small>
                    </span>
                </label>
            </li>
        </template>

        <p>
            <button type="submit" class="button">
                <span class="button__text">{{T "setup.editions.select"}}</span>
                <span class="button__loader" role="progressbar" aria-valuetext="Loading" aria-busy="false" aria-live="assertive" aria-valuemin="0" aria-valuemax="1">
                    <span class="loader" aria-hidden="true"></span>
                </span>
            </button>
        </p>

    </form>
    
        </div>
    </div>
</dialog>
{{end}}
