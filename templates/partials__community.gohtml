{{define "partials/community"}}<div class="community no-print">
    <a href="https://bloodontheclocktower.com/pages/community-created-content-policy" target="_blank" class="community__link">
        <img src="/build/img/community-created.webp" alt="{{T "community.created_content"}}" width="300" height="113" class="community__badge">
    </a>
    <div class="community__text">
        <small>{{T "community.icon_permission"}}</small>
    </div>
</div>
{{end}}
