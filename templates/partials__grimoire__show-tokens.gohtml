{{define "partials/grimoire/show-tokens"}}<button type="button" class="button button--full-height" id="show-tokens" data-dialog="#token-list" disabled>{{T "grimoire.grimoire.show_tokens"}}</button>

<dialog class="dialog dialog--blur-background" id="token-list" data-dialog-hide-on="backdrop" aria-described-by="header-token-list" tabindex="-1">
    <div class="dialog__content">
        <div class="dialog__header">
            <h2 id="header-token-list" class="dialog__title">{{T "grimoire.token_list.title"}}</h2>
            <div class="dialog__hide-wrapper">
                <button class="dialog__hide" type="button" aria-label="{{T "dialog.close"}}" data-dialog-hide>&times;</button>
            </div>
        </div>
        <div class="dialog__body">
        <ul id="token-list__list" class="button-list button-list--reminder"></ul>
    
        </div>
    </div>
</dialog>

<template id="token-list-template">
    <li class="js--token-list--item">
        <button type="button" class="no-btn w-full js--token-list--button">
            <span class="character-list__token js--token-list--token"></span>
        </button>
    </li>
</template>
{{end}}
