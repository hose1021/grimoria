{{define "index"}}{{template "head" .}}
<h1 class="title">{{T "title"}}</h1>

{{template "partials/setup" .}}
{{template "partials/grimoire" .}}
{{template "partials/jinxes" .}}
{{template "partials/night-order" .}}
{{template "partials/info-tokens" .}}
{{template "partials/notes" .}}
{{template "partials/acknowledgements" .}}
{{template "partials/community" .}}

{{template "mainEnd" .}}
<script>
var URLS = {{.URLS}};
var I18N = {{.I18N}};
var ENVIRONMENT = "{{.Env}}";

document.getElementById("info-token-button-holder").dataset.infoTokens = JSON.stringify({{.InfoTokens}});
</script>
<script src="{{.DataScript}}"></script>
{{encoreJS .ScriptEntry}}
{{template "polyfills" .}}
{{template "footer" .}}{{end}}
