{{define "partials/grimoire/add-token"}}<button type="button" class="button button--full-height" id="add-token" data-dialog="#character-list" disabled>{{T "grimoire.grimoire.add_token"}}</button>

<dialog class="dialog dialog--blur-background" id="character-list" data-dialog-hide-on="backdrop" aria-described-by="header-character-list" tabindex="-1">
    <div class="dialog__content">
        <div class="dialog__header">
            <h2 id="header-character-list" class="dialog__title">{{T "grimoire.character_list.title"}}</h2>
            <div class="dialog__hide-wrapper">
                <button class="dialog__hide" type="button" aria-label="{{T "dialog.close"}}" data-dialog-hide>&times;</button>
            </div>
        </div>
        <div class="dialog__body">
    <ul id="character-list__list" class="button-list button-list--reminder character-list"></ul>
    
        </div>
    </div>
</dialog>

<template id="character-list-template">
    <li class="js--character-list--item">
        <button type="button" class="no-btn w-full js--character-list--button">
            <span class="character-list__token js--character-list--token"></span>
        </button>
    </li>
</template>
{{end}}
