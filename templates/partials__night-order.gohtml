{{define "partials/night-order"}}<details class="details" id="night-order">
    <summary class="details__summary">
        <h2 class="details__heading">{{T "night_order.title"}}</h2>
    </summary>
    <div class="details__body">
    <div class="carousel js--night-order--carousel">
        <div class="carousel__item">
            <div class="sidebar sidebar--full ">
                <p class="sidebar__side"><span class="sidebar__side-content">{{T "night_order.first_night"}}</span></p>
                <div class="sidebar__body">
                    <ol id="first-night" class="night-order"></ol>
                </div>
            </div>
        </div>
        <div class="carousel__item">
            <div class="sidebar sidebar--full sidebar--reverse">
                <p class="sidebar__side"><span class="sidebar__side-content">{{T "night_order.other_night"}}</span></p>
                <div class="sidebar__body">
                    <ol id="other-nights" class="night-order"></ol>
                </div>
            </div>
        </div>
    </div>
    <div class="d-none">
        <input type="checkbox" name="night-order" id="night-order-swiped" value="on" aria-label="Show other nights" tabindex="-1">
    </div>
    <p><small>{{T "night_order.swipe_change"}}</small></p>
    {{switch (dict "node" "p" "label" (T "night_order.show_dead") "name" "show-dead" "id" "show-dead")}}
    {{switch (dict "node" "p" "label" (T "night_order.show") "name" "show-all" "id" "show-all")}}
    
    </div>
</details>

<template id="night-info-template">
    <li class="night-order__item js--night-info--wrapper">
        <div class="night-order__heading">
            <div>
                <img src="" alt="" class="night-order__icon js--night-info--icon" loading="lazy">
            </div>
            <p class="night-order__role js--night-info--role"></p>
            <span class="night-order__player-name js--night-info--player-name"></span>
        </div>
        <p class="night-order__ability js--night-info--ability"></p>
    </li>
</template>
{{end}}
