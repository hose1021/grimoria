{{define "partials/setup/character-sheet"}}<button type="button" class="button button--full-height" id="qr-code-button" data-dialog="#qr-code-dialog" disabled>{{T "setup.buttons.qr_code_button"}}</button>

<dialog class="dialog dialog--hide-background" id="qr-code-dialog" data-dialog-hide-on="backdrop" aria-described-by="header-qr-code-dialog" tabindex="-1">
    <div class="dialog__content">
        <div class="dialog__header">
            <h2 id="header-qr-code-dialog" class="dialog__title">{{T "setup.qr_code.title"}}</h2>
            <div class="dialog__hide-wrapper">
                <button class="dialog__hide" type="button" aria-label="{{T "dialog.close"}}" data-dialog-hide>&times;</button>
            </div>
        </div>
        <div class="dialog__body">
        <p>{{T "setup.qr_code.intro"}}</p>
        <a href="{{.SheetURL}}" target="_blank" rel="noopener noreferrer" id="qr-code-link" disabled>
            <span id="qr-code" class="qr"></span>
        </a>

        <p class="mt-4" id="include-groups">{{T "setup.qr_code.include"}}</p>
        <div class="slot slot--2">
            {{switch (dict "node" "div" "label" (T "setup.qr_code.travellers") "name" "include-travellers" "id" "include-travellers" "checked" true "attributes" (dict "aria-describedby" "include-groups"))}}
            {{switch (dict "node" "div" "label" (T "setup.qr_code.fabled") "name" "include-fabled" "id" "include-fabled" "checked" true "attributes" (dict "aria-describedby" "include-groups"))}}
        </div>
    
        </div>
    </div>
</dialog>
{{end}}
