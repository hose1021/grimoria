{{define "partials/setup/clear-cache"}}<button type="button" class="button button--full-height" id="clear-cache-button" data-dialog="#clear-cache">{{T "setup.buttons.clear_cache_button"}}</button>

<dialog class="dialog dialog--blur-background" id="clear-cache" data-dialog-hide-on="backdrop" aria-described-by="header-clear-cache" tabindex="-1">
    <div class="dialog__content">
        <div class="dialog__header">
            <h2 id="header-clear-cache" class="dialog__title">{{T "setup.clear_cache.title"}}</h2>
            <div class="dialog__hide-wrapper">
                <button class="dialog__hide" type="button" aria-label="{{T "dialog.close"}}" data-dialog-hide>&times;</button>
            </div>
        </div>
        <div class="dialog__body">
        <form id="cache-form">

            <p>
                {{switch (dict "label" (T "setup.clear_cache.clear_all") "name" "clear-all" "id" "clear-all" "checked" true)}}
                <small class="d-block">{{T "setup.clear_cache.clear_description"}}</small>
            </p>

            <ul id="clear-individual" class="no-list mb-4 p-2 bd-dark" hidden>
                {{range .Clears}}
                    <li>
                        {{switch (dict "node" "div" "label" .Label "name" "clear" "id" (printf "clear-%s" .Value) "value" .Value "checked" true)}}
                        <small class="d-block">{{.Note}}</small>
                    </li>
                {{end}}
            </ul>

            <p>
                {{switch (dict "label" (T "setup.clear_cache.clear_refresh_label") "name" "clear-refresh" "id" "clear-refresh" "checked" true)}}
                <small class="d-block">{{T "setup.clear_cache.clear_refresh_note"}}</small>
            </p>

            <p id="token-warning"><small>{{TH "setup.clear_cache.warning"}}</small></p>
            <p id="info-token-warning"><small>{{TH "setup.clear_cache.info_token_warning"}}</small></p>
            <p><button type="submit" class="button">{{T "setup.clear_cache.clear_cache"}}</button></p>

        </form>
    
        </div>
    </div>
</dialog>
{{end}}
