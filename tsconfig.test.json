{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test-d.ts",
    "js/types.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
